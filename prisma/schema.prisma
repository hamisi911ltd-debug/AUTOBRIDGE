// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  BUYER
  DEALER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id               String    @id @default(cuid())
  make             String
  model            String
  trim             String
  year             Int
  mileageKm        Int
  fuel             String
  transmission     String
  engineCc         Int
  bodyType         String
  drive            String
  seats            Int
  color            String
  sourceCountry    String
  sourcePriceUsd   Float
  // True when sourcePriceUsd is SBT Japan's own "Total Price" (their C&F —
  // Cost & Freight — figure to Mombasa) rather than the bare vehicle/FOB
  // price — landedCost.ts must not add freight again on top for these, or
  // it double-counts shipping already baked into the price shown. BE
  // FORWARD has no equivalent field on its site; always false there.
  freightIncluded  Boolean   @default(false)
  imageUrl         String?
  imageUrls        String? // JSON-encoded string[] — up to 5 gallery photos; imageUrls[0] is always the same as imageUrl when present
  imageWidthPx     Int? // actual verified pixel width of imageUrl — lets the public site filter out lingering low-res thumbnails without re-deriving quality from process history
  condition        String
  badge            String?
  lifestyle        String // JSON-encoded string[] (SQLite has no native array type)
  eligible         Boolean   @default(true)
  ineligibleReason String?
  // Scraped-listing tracking — null for hand-entered admin vehicles.
  // sourceSite + externalId together let the nightly scraper upsert instead
  // of creating duplicates on every run.
  sourceSite       String?
  externalId       String?   @unique
  sourceUrl        String? // direct link to the original listing on beforward.jp / sbtjapan.com
  lastScrapedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  enquiries Enquiry[]

  @@index([make, model])
  @@index([sourceCountry])
  @@index([bodyType])
}

enum ScopeType {
  GLOBAL
  COUNTRY
  EXPORTER
  BODY_TYPE
  MAKE
  MODEL
  PRICE_BAND
}

enum MarkupType {
  PERCENT
  FIXED
  TIERED
}

model PricingRule {
  id            String     @id @default(cuid())
  name          String
  scopeType     ScopeType
  scopeValue    String? // e.g. "Japan", "Toyota" — null for GLOBAL/PRICE_BAND
  markupType    MarkupType
  value         Float? // used by PERCENT (as fraction, e.g. 0.08) and FIXED (USD amount)
  tiers         String? // JSON-encoded [{min, max, percent}] — used by TIERED
  priceMinUsd   Float? // used by PRICE_BAND scope
  priceMaxUsd   Float? // used by PRICE_BAND scope
  minProfitUsd  Float?
  maxProfitUsd  Float?
  priority      Int        @default(0)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Enquiry {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  name      String
  phone     String
  email     String?
  message   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

// Real customer feedback only — entered by an admin from an actual
// conversation (WhatsApp, call, email), never generated. `published`
// gates whether it's live on the homepage, so a review can be logged
// internally before being made public.
model Review {
  id             String   @id @default(cuid())
  customerName   String
  rating         Int // 1-5
  text           String
  vehicleLabel   String? // free-text e.g. "Toyota Harrier" — no FK, the vehicle listing itself may be long gone by the time a review comes in
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
}
