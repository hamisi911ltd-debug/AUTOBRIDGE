# SQLite file for local dev — Prisma reads this as a plain file path via the
# better-sqlite3 driver adapter, not a URL scheme.
DATABASE_URL="file:./prisma/dev.db"

# Auth.js session signing secret. Generate one with:
#   npx auth secret
AUTH_SECRET=

# Shared secret checked by /api/cron/scrape-vehicles before it will run a
# scrape. Must match the CRON_SECRET set on the cron-worker (see
# cron-worker/README.md). Generate any long random string.
CRON_SECRET=
